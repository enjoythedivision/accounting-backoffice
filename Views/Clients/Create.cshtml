@model Accounting.BackOffice.Models.Client

<h1>Προσθήκη Πελάτη</h1>
<form asp-action="Create" method="post">
    <input asp-for="FullName" placeholder="Όνομα Πελάτη" />
    <input asp-for="Email" placeholder="Email Πελάτη" />
    <input asp-for="Phone" placeholder="Τηλέφωνο Πελάτη" />
    <input asp-for="MonthlyFee" type="number" step="0.01" placeholder="Μηνιαία Οφειλή" />
    <div asp-validation-summary="All"></div>
    <button type="submit">Προσθήκη</button>
</form>